{
  "id": "dannysoul-agent-dialogue",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "maxTriangleTurns": {
        "type": "number",
        "minimum": 2,
        "maximum": 50,
        "description": "Max turns in a triangle dialogue (default: 20)"
      },
      "maxPingPongTurns": {
        "type": "number",
        "minimum": 1,
        "maximum": 10,
        "description": "Max turns in a ping-pong dialogue (default: 5)"
      },
      "agentReplyTimeoutMs": {
        "type": "number",
        "minimum": 5000,
        "maximum": 120000,
        "description": "Agent reply timeout in ms (default: 30000)"
      },
      "parallelReplies": {
        "type": "boolean",
        "description": "Request agent replies in parallel (default: true)"
      },
      "showAgentEmoji": {
        "type": "boolean",
        "description": "Prefix agent replies with emoji (default: true)"
      },
      "concludeOnConsensus": {
        "type": "boolean",
        "description": "Auto-conclude when agents reach consensus (default: true)"
      }
    }
  },
  "uiHints": {
    "maxTriangleTurns": {
      "label": "Max Triangle Turns",
      "placeholder": "20"
    },
    "maxPingPongTurns": {
      "label": "Max Ping-Pong Turns",
      "placeholder": "5"
    },
    "agentReplyTimeoutMs": {
      "label": "Reply Timeout",
      "placeholder": "30000",
      "advanced": true
    }
  }
}
